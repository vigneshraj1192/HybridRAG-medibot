# ========================================================
# MediBot Environment Configuration
# ========================================================
# Copy this file to '.env' and populate with your own credentials:
#   cp .env.example .env (Linux / macOS) or copy .env.example .env (Windows)
# ========================================================

# --- LLM Provider API Keys (At least one is recommended) ---
# Google Gemini API Key (Recommended for high-speed, grounded reasoning)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud API Key (Fallback or alternative high-throughput Llama 3.3 inference)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Server & Authentication Config ---
# Secret key used for signing and verifying role-based JWT tokens
JWT_SECRET=medibot_super_secret_jwt_key_2026

# Backend FastAPI HTTP server port (Default: 8000)
PORT=8000
